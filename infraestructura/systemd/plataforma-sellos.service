# Sello de tiempo de las imágenes, los informes y las versiones en Hedera (funcionalidades 016 y 023, RF37).
[Unit]
Description=evidentIA - sellos de tiempo en Hedera
After=network.target postgresql.service redis-server.service

[Service]
Type=oneshot
User=plataforma
Group=plataforma
WorkingDirectory=/opt/plataforma/actual/backend
EnvironmentFile=/opt/plataforma/.env
ExecStart=/opt/plataforma/actual/venv/bin/flask --app wsgi sellos procesar
NoNewPrivileges=true
PrivateTmp=true
