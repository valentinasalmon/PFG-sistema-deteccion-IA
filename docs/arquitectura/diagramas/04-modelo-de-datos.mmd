  USUARIOS {
    int id PK
    string correo UK
    string perfil "Abogado o Aseguradora"
    string rol "usuario o administrador"
    string google_sub UK
    bool activo
  }
  ORGANIZACIONES {
    int id PK
    string nombre
    string tipo "estudio o aseguradora"
    string plan
    string cuit
    string estado
  }
  MEMBRESIAS {
    int id PK
    int id_organizacion FK
    int id_usuario FK
    string rol "referente o miembro"
  }
  INVITACIONES {
    int id PK
    int id_organizacion FK
    string correo
    string estado
    datetime vence_en
  }
  CASOS {
    int id PK
    string numero UK
    int id_organizacion FK
    int id_responsable FK
    string expediente
    string estado
    datetime retencion_desde
  }
  ACCESOS_CASO {
    int id PK
    int id_caso FK
    int id_usuario FK
    string nivel "colaborador o lector"
  }
  IMAGENES {
    int id PK
    int id_caso FK
    string huella "SHA-256"
    string formato
    string origen
    string sello_referencia "Hedera"
  }
  ENLACES_CARGA {
    int id PK
    int id_caso FK
    string huella_token UK
    string tipo "celular o persona afectada"
    datetime vence_en
  }
  ANALISIS {
    int id PK
    int id_caso FK
    string estado
    json versiones
  }
  ANALISIS_IMAGENES {
    int id PK
    int id_analisis FK
    int id_imagen FK
    string huella
  }
  RESULTADOS_CAPA {
    int id PK
    int id_analisis_imagen FK
    string capa
    int nivel
    string version
  }
  ANOMALIAS {
    int id PK
    int id_resultado FK
    string campo
    string severidad
  }
  INFORMES {
    int id PK
    int id_analisis FK
    string huella "SHA-256"
    string codigo_verificacion
    string sello_referencia "Hedera"
  }
  AUDITORIA {
    bigint id PK
    datetime fecha
    int id_usuario FK
    string accion
    string resultado
  }
  VERSIONES_SISTEMA {
    int id PK
    string commit
    string huella
    string sello_referencia "Hedera"
  }
