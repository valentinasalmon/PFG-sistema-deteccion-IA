erDiagram
  USUARIOS ||--o{ MEMBRESIAS : "pertenece"
  ORGANIZACIONES ||--o{ MEMBRESIAS : "tiene"
  ORGANIZACIONES ||--o{ INVITACIONES : "envía"
  USUARIOS ||--o{ INVITACIONES : "invita"
  ORGANIZACIONES |o--o{ CASOS : "agrupa"
  USUARIOS ||--o{ CASOS : "es responsable"
  CASOS ||--o{ ACCESOS_CASO : "otorga"
  USUARIOS |o--o{ ACCESOS_CASO : "recibe"
  CASOS ||--o{ IMAGENES : "contiene"
  CASOS ||--o{ ENLACES_CARGA : "habilita"
  CASOS ||--o{ ANALISIS : "registra"
  ANALISIS ||--o{ ANALISIS_IMAGENES : "examina"
  IMAGENES |o--o{ ANALISIS_IMAGENES : "se analiza en"
