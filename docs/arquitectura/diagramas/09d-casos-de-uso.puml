@startuml casos-de-uso-imágenesanálisiseinformes
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4E5B54
skinparam nodesep 40
skinparam ranksep 55
skinparam linetype polyline
skinparam ArrowColor #333333
skinparam actor {
  BorderColor #222222
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #555555
  FontStyle bold
}
left to right direction

actor "Colaborador" as colaborador
actor "Responsable" as responsable
actor "Lector" as lector
actor "Persona afectada" as personaafectada
actor "Sistema\n(procesos automáticos)" as sistema
actor "Usuario" as usuario
actor "Visitante" as visitante
rectangle "evidentIA: imágenes, análisis e informes" {
  usecase "Cargar imágenes\n(CU25)" as CU25
  usecase "Eliminar imagen\n(CU26)" as CU26
  usecase "Analizar imágenes\n(CU27)" as CU27
  usecase "Consultar y descargar informes\n(CU29)" as CU29
  usecase "Cargar imágenes desde el celular\n(CU33)" as CU33
  usecase "Subir imágenes como persona afectada\n(CU34)" as CU34
  usecase "Procesar análisis y generar informe\n(CU28)" as CU28
  usecase "Consultar panel principal\n(CU30)" as CU30
  usecase "Verificar un informe\n(CU35)" as CU35
}
CU25 -- responsable
colaborador -- CU25
CU26 -- responsable
colaborador -- CU26
CU27 -- responsable
colaborador -- CU27
CU29 -- responsable
colaborador -- CU29
lector -- CU29
CU33 -- responsable
colaborador -- CU33
CU34 -- personaafectada
sistema -- CU28
CU30 -- usuario
visitante -- CU35
CU33 .> CU25 : <<extend>>
@enduml
