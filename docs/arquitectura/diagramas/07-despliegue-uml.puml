@startuml despliegue
' Diagrama de despliegue (UML 2.5). Datos verificados contra la infraestructura con
' «python herramientas/diagramas_del_sistema.py verificar».
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4E5B54
skinparam nodesep 45
skinparam ranksep 60
skinparam nodeBorderColor #2F5DA8
skinparam nodeBackgroundColor #F7F9FC
skinparam artifactBackgroundColor #FFFFFF
skinparam artifactBorderColor #4E5B54
skinparam databaseBackgroundColor #EAF0F9
skinparam databaseBorderColor #2F5DA8
top to bottom direction

node "Microsoft Clarity" <<external system>> as clarity
node "Computadora o celular del usuario" <<device>> as disp {
  node "Navegador web" <<executionEnvironment>> as nav {
    artifact "Interfaz React\n(aplicación de una página)" as spa
  }
}

node "Amazon Web Services · región eu-west-1 (Irlanda)" <<cloud>> as aws {
node "Amazon EC2 t3.small" <<device>> as ec2 {
  node "Ubuntu Server 24.04" <<executionEnvironment>> as so {
    node "Nginx (TLS, puerto 443)" <<executionEnvironment>> as nginx {
      artifact "frontend/dist\n(archivos estáticos)" as estaticos
    }
    node "Gunicorn · Python 3.12\n(127.0.0.1:8000)" <<executionEnvironment>> as gunicorn {
      artifact "API REST Flask\n(wsgi.py)" as api
    }
    node "Trabajador de análisis (RQ)" <<executionEnvironment>> as rq {
      artifact "trabajador.py" as trab
    }
    node "systemd (tareas programadas)" <<executionEnvironment>> as timers {
      artifact "plataforma-sellos.timer\n(sellos en Hedera)" as tsellos
      artifact "plataforma-retencion.timer\n(retención de los casos)" as tret
      artifact "plataforma-respaldo.timer\n(respaldo de PostgreSQL)" as tresp
    }
    database "PostgreSQL" as pg
    database "Redis" as redis
  }
}

node "Amazon S3" <<cloud service>> as s3 {
  artifact "imágenes e informes\n(cifrados, versionados)" as objetos
  artifact "respaldos y artefactos\nde despliegue" as respaldos
}
node "Amazon SES" <<cloud service>> as ses
node "Parameter Store\n(AWS Systems Manager)" <<cloud service>> as ssm
}
node "Hedera Consensus Service" <<external system>> as hedera
node "Google Identity" <<external system>> as google
node "Cresium" <<external system>> as cresium
node "Identik" <<external system>> as identik
hedera -[hidden]down- cresium
google -[hidden]down- identik
s3 -[hidden]down- ses

nav --> nginx : HTTPS (TLS · 443)
nav ..> clarity : HTTPS\n(período de prueba)
nginx --> gunicorn : HTTP local
gunicorn --> redis : TCP 6379
gunicorn --> pg : TCP 5432
rq --> redis : TCP 6379
rq --> pg : TCP 5432
timers --> pg : TCP 5432

ec2 -down-> s3 : HTTPS
ec2 -down-> ses : SMTP + STARTTLS
ec2 -down-> ssm : HTTPS
ec2 -down-> hedera : gRPC · HTTPS\n(mirror node)
ec2 -down-> google : HTTPS\n(OIDC + PKCE)
ec2 .down.> cresium : <<previsto>>\nHTTPS
ec2 .down.> identik : <<previsto>>\nHTTPS
@enduml
