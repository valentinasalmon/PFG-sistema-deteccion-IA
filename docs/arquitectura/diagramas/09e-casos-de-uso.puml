@startuml casos-de-uso-retención
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4E5B54
skinparam nodesep 40
skinparam ranksep 55
skinparam linetype polyline
skinparam ArrowColor #333333
skinparam actor {
  BorderColor #222222
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #555555
  FontStyle bold
}
left to right direction

actor "Responsable" as responsable
actor "Sistema\n(procesos automáticos)" as sistema
rectangle "evidentIA: retención" {
  usecase "Prorrogar retención\n(CU31)" as CU31
  usecase "Aplicar política de retención\n(CU32)" as CU32
}
responsable -- CU31
CU32 -- sistema
@enduml
