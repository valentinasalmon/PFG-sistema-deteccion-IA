@startuml casos-de-uso-casos
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4E5B54
skinparam nodesep 40
skinparam ranksep 55
skinparam linetype polyline
skinparam ArrowColor #333333
skinparam actor {
  BorderColor #222222
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #333333
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #555555
  FontStyle bold
}
left to right direction

actor "Responsable" as responsable
actor "Usuario" as usuario
actor "Colaborador" as colaborador
rectangle "evidentIA: casos" {
  usecase "Editar caso\n(CU20)" as CU20
  usecase "Cambiar estado del caso\n(CU21)" as CU21
  usecase "Compartir caso y gestionar accesos\n(CU22)" as CU22
  usecase "Transferir caso\n(CU23)" as CU23
  usecase "Eliminar caso\n(CU24)" as CU24
  usecase "Crear caso\n(CU18)" as CU18
  usecase "Buscar y consultar casos\n(CU19)" as CU19
}
responsable -- CU20
colaborador -- CU20
responsable -- CU21
responsable -- CU22
responsable -- CU23
responsable -- CU24
CU18 -- usuario
CU19 -- usuario
@enduml
