# Variables de entorno del backend.
# Copiar este archivo como .env (que NO se sube al repositorio) y completar.

# Entorno: desarrollo | pruebas | produccion
ENTORNO=desarrollo

# Clave para firmar sesiones y tokens. En producción debe ser larga y aleatoria:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=cambiar-por-una-clave-larga-y-aleatoria

# Servicios levantados con docker compose (ver docker-compose.yml en la raíz)
URL_BASE_DATOS=postgresql+psycopg://sistema:sistema@localhost:5432/sistema_deteccion
URL_REDIS=redis://localhost:6379/0


# Dirección de la interfaz web: se usa para armar los enlaces de los correos.
URL_FRONTEND=http://localhost:5173

# Envío de correos. En desarrollo, Mailpit (docker compose) los captura y se
# ven en http://localhost:8025. En producción se usa Amazon SES por SMTP.
SERVIDOR_CORREO=localhost
PUERTO_CORREO=1025
USUARIO_CORREO=
CONTRASENIA_CORREO=
USAR_TLS_CORREO=no
REMITENTE_CORREO=Plataforma de análisis de imágenes <no-responder@localhost>

# Correos que reciben el rol de Administrador al iniciar sesión, separados por
# comas (la cuenta tiene que estar registrada y verificada). Ejemplo:
#   ADMINISTRADORES=persona@ejemplo.com
ADMINISTRADORES=

# Almacenamiento de las imágenes de los casos (funcionalidad 006).
# En desarrollo se guardan en backend/almacenamiento_local/, que está en
# .gitignore y nunca se sube. En producción se usa S3 (ALMACENAMIENTO=s3).
ALMACENAMIENTO=local
# DIRECTORIO_ALMACENAMIENTO=/ruta/a/otra/carpeta
# S3_BUCKET=
# S3_REGION=sa-east-1

# Análisis de imágenes (funcionalidad 007). En desarrollo, "hilo" ejecuta los
# análisis dentro del servidor; "rq" necesita el trabajador (python trabajador.py).
COLA_ANALISIS=hilo
# RUTA_EXIFTOOL=exiftool
# Lista de confianza de C2PA para la capa 2 (funcionalidad 009). Por defecto se
# usa la que viene en recursos/confianza_c2pa/.
# CARPETA_CONFIANZA_C2PA=/ruta/a/la/lista
