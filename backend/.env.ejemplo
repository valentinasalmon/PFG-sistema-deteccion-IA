# Variables de entorno del backend.
# Copiar este archivo como .env (que NO se sube al repositorio) y completar.

# Entorno: desarrollo | pruebas | produccion
ENTORNO=desarrollo

# Clave para firmar sesiones y tokens. En producción debe ser larga y aleatoria:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CLAVE_SECRETA=cambiar-por-una-clave-larga-y-aleatoria

# Servicios levantados con docker compose (ver docker-compose.yml en la raíz)
URL_BASE_DATOS=postgresql+psycopg://sistema:sistema@localhost:5432/sistema_deteccion
URL_REDIS=redis://localhost:6379/0